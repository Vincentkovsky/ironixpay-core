# Chain Configuration — Production Template
# Copy to chains.production.toml and fill in actual addresses.
# This file is loaded by the backend at startup via CHAINS_CONFIG_PATH env var.
# No secrets here! Keep private keys and API keys in .env.
#
# TRON address fields are SAFETY ASSERTIONS — they are verified against
# HD-derived addresses at startup. Mismatch = panic.
# EVM addresses are purely HD-derived and do not need TOML assertion.
#
# RPC Failover: use `rpc_urls` (array) for primary + fallback endpoints.
# Backward compatible: `rpc_url` (single string) still works.
#
# outbound_fee: Per-chain flat fee for Withdrawal + Payout (USDT microunits).
# Falls back to global default (1.5 USDT) if not set.

[chains.TRON]
rpc_url = "https://api.trongrid.io"
# m/44'/195'/0'/0/0 — Safety assertion (verified at startup)
treasury_address = "<FILL_IN_TRON_TREASURY_ADDRESS>"
outbound_fee = 1500000  # 1.5 USDT

[chains.TRON.gas_sponsor]
# m/44'/195'/0'/0/1 — Safety assertion (verified at startup)
address = "<FILL_IN_TRON_GAS_SPONSOR_ADDRESS>"
account_index = 0
path_index = 1

# ── EVM Chains (all share HD-derived addresses from coin_type=60) ──
# Treasury: m/44'/60'/0'/0/0   Gas Sponsor: m/44'/60'/0'/0/1
# Each chain only needs rpc_urls + gas_sponsor signing path.
# Add/remove chains as needed — backend auto-discovers from keys.
# RPC failover: first URL is primary, rest are fallbacks.

[chains.BSC]
rpc_urls = [
    "https://bnb-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>",
    "https://rpc.ankr.com/bsc/<ANKR_API_KEY>",
]
outbound_fee = 500000  # 0.5 USDT

[chains.BSC.gas_sponsor]
account_index = 0
path_index = 1

