# Server
HOST=0.0.0.0
PORT=3000

# Local PostgreSQL from the root docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ironixpay_dev
DATABASE_MAX_CONNECTIONS=20

# Local development uses test networks only.
ENVIRONMENT=Sandbox
CHAINS_CONFIG_PATH=chains.toml

# Generate unique values. Never reuse production credentials or a funded seed.
JWT_SECRET=<generate-a-long-random-value>
ENCRYPTION_KEY=<generate-64-lowercase-hex-characters>
MASTER_MNEMONIC=<new-test-only-12-or-24-word-bip39-mnemonic>

# Local frontend URLs
CHECKOUT_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:5175

# Address and session lifecycle
ADDRESS_POOL_SIZE=20
ADDRESS_TTL_SECONDS=1800
RECYCLE_CHECK_INTERVAL_SECONDS=300
SESSION_EXPIRY_MINUTES=30

# Authentication and abuse protection
JWT_EXPIRY_HOURS=24
RATE_LIMIT_PER_MINUTE=120
TURNSTILE_REQUIRED=false
TURNSTILE_EXPECTED_HOSTNAME=localhost
BLOCKED_EMAIL_DOMAINS=example.invalid

# Webhooks
WEBHOOK_RETRY_MAX=5
WEBHOOK_TIMEOUT_SECONDS=30

# Optional integrations
# TRONGRID_API_KEY=<your-trongrid-api-key>
# RESEND_API_KEY=<your-resend-api-key>
# NETTS_API_KEY=<your-energy-provider-api-key>
# ALERT_WEBHOOK_URL=<your-alert-webhook-url>
LEAD_NOTIFICATION_EMAIL=dev@example.com

# Development-only admin access. Replace before starting the backend.
ADMIN_TOKEN=<generate-a-long-random-value>
